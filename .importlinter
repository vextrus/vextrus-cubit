# import-linter's contracts (docs/architecture.md, the module map; ADR 0034). Run: uv run lint-imports
# They change only when a module is added, never per feature.

[importlinter]
root_packages =
    vextrus
    engine
include_external_packages = True

[importlinter:contract:layers]
name = The modules import only lower layers; modules on one line are independent siblings
type = layers
containers = vextrus
layers =
    urls
    api | seed
    summary | exports | assistant | revisions
    boq
    takeoff | measurement | rates
    live_model
    drawings
    projects
    platform

[importlinter:contract:engine]
name = The engine imports no Django, no web framework and no Vextrus module
type = forbidden
source_modules =
    engine
forbidden_modules =
    vextrus
    django
    ninja
    procrastinate
    psycopg

[importlinter:contract:private-models-platform]
name = Private models: only platform, its seed and the test fixtures import vextrus.platform.models
type = protected
protected_modules =
    vextrus.platform.models
allowed_importers =
    vextrus.platform
    vextrus.seed.platform
    vextrus.testing

