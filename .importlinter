# import-linter's contracts (docs/architecture.md, the module map; ADR 0034). Run: uv run lint-imports
# They change only when a module is added, never per feature.

[importlinter]
root_packages =
    vextrus
    engine
include_external_packages = True

[importlinter:contract:layers]
name = The modules import only lower layers; modules on one line are independent siblings
type = layers
containers = vextrus
layers =
    urls
    api | seed
    summary | exports | assistant | revisions
    boq
    takeoff | measurement | rates
    live_model
    drawings
    projects
    platform
# Ticket 19a's committed acceptance tests run the whole demo seed (a layer above takeoff) on the API; a
# builder may not change them, so their imports of the seed alone are let through; 182's likewise (they
# seed with the toolchain switched off).
ignore_imports =
    vextrus.takeoff.tests.acceptance.t19a.* -> vextrus.seed.*
    vextrus.takeoff.tests.acceptance.t182.* -> vextrus.seed.*
unmatched_ignore_imports_alerting = none

[importlinter:contract:engine]
name = The engine imports no Django, no web framework and no Vextrus module
type = forbidden
source_modules =
    engine
forbidden_modules =
    vextrus
    django
    ninja
    procrastinate
    psycopg

[importlinter:contract:private-models-platform]
name = Private models: only platform, its seed and the test fixtures import vextrus.platform.models
type = protected
protected_modules =
    vextrus.platform.models
allowed_importers =
    vextrus.platform
    vextrus.seed.platform
    vextrus.testing
# Ticket 19a's committed acceptance tests read a user and the override log (JevOverride) directly, and
# 136's and 182's a User; a builder may not change them, so their imports alone are let through.
ignore_imports =
    vextrus.takeoff.tests.acceptance.t19a.step1 -> vextrus.platform.models
    vextrus.takeoff.tests.acceptance.t182.test_seed_without_the_toolchain -> vextrus.platform.models
    vextrus.takeoff.tests.acceptance.t19a.test_step1_confirm -> vextrus.platform.models
    vextrus.seed.tests.acceptance.t136.seeded -> vextrus.platform.models
unmatched_ignore_imports_alerting = none

[importlinter:contract:private-models-projects]
name = Private models: only projects, its seed and the test fixtures import vextrus.projects.models
type = protected
protected_modules =
    vextrus.projects.models
allowed_importers =
    vextrus.projects
    vextrus.seed.projects
    vextrus.testing

[importlinter:contract:private-models-drawings]
name = Private models: only drawings, its seed and the test fixtures import vextrus.drawings.models
type = protected
protected_modules =
    vextrus.drawings.models
allowed_importers =
    vextrus.drawings
    vextrus.seed.drawings
    vextrus.testing
# Ticket 21b's committed acceptance tests read a file's kept steps (ReadStep) directly; a builder may
# not change them, so their two imports alone are let through.
ignore_imports =
    vextrus.takeoff.tests.acceptance.t21b.test_read_sheets -> vextrus.drawings.models
    vextrus.takeoff.tests.acceptance.t21b.test_read_sheets_toolchain -> vextrus.drawings.models
unmatched_ignore_imports_alerting = none

[importlinter:contract:private-models-live-model]
name = Private models: only live_model and the test fixtures import vextrus.live_model.models
type = protected
protected_modules =
    vextrus.live_model.models
allowed_importers =
    vextrus.live_model
    vextrus.testing

[importlinter:contract:private-models-takeoff]
name = Private models: only takeoff, its seed and the test fixtures import vextrus.takeoff.models
type = protected
protected_modules =
    vextrus.takeoff.models
allowed_importers =
    vextrus.takeoff
    vextrus.seed.takeoff
    vextrus.testing
# Ticket 136's committed acceptance tests read the drawing list's source sheet
# (DrawingRegister.source_sheet_id), which no API names; a builder may not change them, so their
# one import alone is let through (t136's `seeded` reads a User the same way, above).
ignore_imports =
    vextrus.seed.tests.acceptance.t136.test_kr01_drawing_list -> vextrus.takeoff.models
unmatched_ignore_imports_alerting = none

