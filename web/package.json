{
  "name": "vextrus-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc -b",
    "lint": "eslint --max-warnings 0 . && node scripts/lint-css.mjs",
    "lint:design-docs": "node scripts/lint-design-docs.mjs",
    "messages:extract": "lingui extract --clean",
    "messages:compile": "lingui compile --strict && lingui compile --strict --config lingui.messages.config.ts",
    "messages:check": "node scripts/check-messages.mjs",
    "api:types": "node scripts/api-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@lingui/core": "6.8.0",
    "@lingui/react": "6.8.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.8.0",
    "@lingui/cli": "6.8.0",
    "@lingui/conf": "6.8.0",
    "@lingui/format-po": "6.8.0",
    "@lingui/message-utils": "6.8.0",
    "@lingui/vite-plugin": "6.8.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.39",
    "@tanstack/router-plugin": "1.168.41",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
