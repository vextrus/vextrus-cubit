#. vextrus/takeoff/messages/frame.py (ticket S16-T2): Steps 3, 4 and 6's acts and refusals.
msgid "takeoff.frame.act_unknown"
msgstr "That is not something you can do here. Confirm, exclude, edit or unconfirm."

msgid "takeoff.frame.confirmed"
msgstr "{actor} confirmed {count, plural, one {# proposal} other {# proposals}}"

msgid "takeoff.frame.edited"
msgstr "{actor} typed values for {count, plural, one {# proposal} other {# proposals}}"

msgid "takeoff.frame.excluded"
msgstr "{actor} excluded {count, plural, one {# proposal} other {# proposals}}"

msgid "takeoff.frame.levels_typed"
msgstr "{actor} typed the levels of {count, plural, one {# storey} other {# storeys}}"

msgid "takeoff.frame.no_building"
msgstr "This project has no building yet, so nothing was confirmed. Add a building first."

msgid "takeoff.frame.not_a_number"
msgstr "Type a number, like 3.048."

msgid "takeoff.frame.nothing_chosen"
msgstr "Choose at least one proposal first."

msgid "takeoff.frame.size_needed"
msgstr "Type both sides of the column and their unit, like 250 × 500 mm."

msgid "takeoff.frame.step_unknown"
msgstr "That step is not one of the storeys, grid or columns steps. Reload the page."

msgid "takeoff.frame.storey_unknown"
msgstr "One of the storeys chosen is not a storey of this project. Reload the page and choose again."

msgid "takeoff.frame.unconfirmed"
msgstr "{actor} unconfirmed {count, plural, one {# proposal} other {# proposals}}"

msgid "takeoff.frame.view_placed"
msgstr "{actor} put a view on {count, plural, one {# storey} other {# storeys}}"
