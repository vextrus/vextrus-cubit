#. vextrus/drawings/messages/sheets.py (ticket 14): why a sheet has no Plot (m0-screens 4.6), and refusals of a decision about a sheet or a view.
msgid "drawings.sheets.decided_already"
msgstr "This sheet is already confirmed or left out, so it was not changed. Undo that first, then answer again."

msgid "drawings.sheets.kind_unknown"
msgstr "That kind of sheet or view is not one Vextrus offers, so nothing was changed. Choose one from the list."

msgid "drawings.sheets.title_empty"
msgstr "That title is empty, so nothing was changed. Type the title as its title block prints it."

msgid "drawings.sheets.title_too_long"
msgstr "That title is longer than {limit, plural, one {# character} other {# characters}}, so nothing was changed. Type only the title, as its title block prints it."

msgid "drawings.sheets.title_many_lines"
msgstr "That title runs over more than one line, so nothing was changed. Type it on one line, as its title block prints it."

msgid "drawings.sheets.title_drawing_code"
msgstr "That title holds code copied from drawing text, so nothing was changed. Type the words the title block prints."

msgid "drawings.sheets.title_unreadable"
msgstr "That title holds a character a title block cannot print, such as a tab or a hidden mark, so nothing was changed. Type it again by hand."

msgid "drawings.sheets.number_empty"
msgstr "That number is empty, so nothing was changed. Type the number as its title block prints it."

msgid "drawings.sheets.number_too_long"
msgstr "That number is longer than {limit, plural, one {# character} other {# characters}}, so nothing was changed. Type only the number, as its title block prints it."

msgid "drawings.sheets.number_many_lines"
msgstr "That number runs over more than one line, so nothing was changed. Type it on one line, as its title block prints it."

msgid "drawings.sheets.number_drawing_code"
msgstr "That number holds code copied from drawing text, so nothing was changed. Type the number the title block prints."

msgid "drawings.sheets.number_unreadable"
msgstr "That number holds a character a title block cannot print, such as a tab or a hidden mark, so nothing was changed. Type it again by hand."

msgid "drawings.sheets.other_needs_text"
msgstr "Nothing was left out: \"Other\" needs a few words. Say why it is left out."

msgid "drawings.sheets.plot_no_number"
msgstr "No Plot for this sheet: the sheet has no number, so no PDF page could be matched to it."

msgid "drawings.sheets.plot_no_page"
msgstr "No Plot for this sheet: no page of {plot_file} matched it."

msgid "drawings.sheets.plot_no_pdf"
msgstr "No Plot for this sheet: no PDF has been added for {discipline}."

msgid "drawings.sheets.plot_no_pdf_any"
msgstr "No Plot for this sheet: no PDF has been added to this Drawing Set."

msgid "drawings.sheets.plot_not_matched"
msgstr "No Plot for this sheet: {plot_file} has been read, but its pages were not matched to the sheets. Tell Vextrus."

msgid "drawings.sheets.plot_not_yet"
msgstr "No Plot for this sheet yet: its PDF is still being read."

msgid "drawings.sheets.plot_pdf_refused"
msgstr "No Plot for this sheet: its PDF was a scan and was refused."

msgid "drawings.sheets.plot_pdf_unread"
msgstr "No Plot for this sheet: its PDF was not read. Its row on the Drawing Set page says why."

msgid "drawings.sheets.reason_unknown"
msgstr "That reason is not one Vextrus offers, so nothing was changed. Choose one from the list."

msgid "drawings.sheets.text_only_for_other"
msgstr "Nothing was left out: only \"Other\" takes words of its own. Choose \"Other\" to give your reason, or leave the words out."

msgid "drawings.sheets.text_unreadable"
msgstr "Those words hold a character that cannot be kept, so nothing was left out. Type them again, or paste them as plain text."

msgid "drawings.sheets.storeys_empty"
msgstr "No storey was given, so nothing was changed. List each storey the plan draws, for example 3rd, 5th, 7th."

msgid "drawings.sheets.storeys_too_long"
msgstr "That list of storeys is longer than {limit, plural, one {# character} other {# characters}}, so nothing was changed. List only the storeys the plan draws."

msgid "drawings.sheets.storeys_many_lines"
msgstr "The storeys must be on one line, so nothing was changed. List them separated by commas, for example 3rd, 5th, 7th."

msgid "drawings.sheets.storeys_drawing_code"
msgstr "Those storeys hold code copied from drawing text, so nothing was changed. Type the storeys the plan draws, for example 3rd, 5th, 7th."

msgid "drawings.sheets.storeys_unreadable"
msgstr "Those storeys hold a character that cannot be kept, such as a tab or a hidden mark, so nothing was changed. Type them again by hand."

msgid "drawings.sheets.storeys_read_together"
msgstr "Read together as one list, those storeys name other storeys than each names alone, so nothing was changed. List each storey by its full name, for example 3rd floor, 5th floor, roof."

msgid "drawings.sheets.storeys_not_a_storey"
msgstr "\"{word}\" does not name a storey, so nothing was changed. Name each storey, for example 3rd, ground or roof."

msgid "drawings.sheets.storeys_range"
msgstr "\"{word}\" names a range, and each storey must be listed on its own, so nothing was changed. List every storey the plan draws, for example 2nd, 3rd, 4th."

msgid "drawings.sheets.storeys_too_many"
msgstr "More than {limit, plural, one {# storey} other {# storeys}} were listed, so nothing was changed. List only the storeys the plan draws."

msgid "drawings.sheets.storeys_meaning_unknown"
msgstr "The storeys must mean either \"at floor level\" or \"floor to floor\", so nothing was changed. Choose one."

msgid "drawings.sheets.storeys_view_unknown"
msgstr "That view is not on this sheet, so nothing was changed. Cancel the correction and open it again with E."

msgid "drawings.sheets.storeys_not_a_plan"
msgstr "That view is not a plan, and only a plan view has storeys, so nothing was changed. Cancel the correction and open it again with E."

msgid "drawings.sheets.storeys_view_twice"
msgstr "One view was given storeys twice, so nothing was changed. Cancel the correction and open it again with E."
