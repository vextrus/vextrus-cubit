#. vextrus/drawings/messages/files.py (ticket 14): a file's status in m0-screens 4.5's words, and the acts on files.
msgid "drawings.files.added"
msgstr "{actor} added a file to the Drawing Set"

msgid "drawings.files.already_ended"
msgstr "This file's reading has already ended, so it was not started again. Its row shows how it ended."

msgid "drawings.files.await_resaved"
msgstr "Set aside: waiting for the re-saved file"

msgid "drawings.files.cancelled"
msgstr "Cancelled by {actor}{vextrus, select, yes { (Vextrus)} other {}}, {cancelled_date}. Nothing from it is in the sheet list."

msgid "drawings.files.cancelled_unnamed"
msgstr "Cancelled. Nothing from it is in the sheet list."

msgid "drawings.files.discipline_changed"
msgstr "{actor} changed a file's Discipline"

msgid "drawings.files.discipline_sheet_decided"
msgstr "{sheet} from this file is already confirmed or left out in Step 1, so the file's Discipline was not changed. To change it, undo that decision in Step 1 first."

msgid "drawings.files.discipline_choice_undone"
msgstr "The choice of {discipline} for this file was undone when its sheets were read: {discipline} already has a sheet {sheet} from another file, so the file now has no Discipline. Choose its Discipline on the file's row, or open {sheet} in Step 1 to see which file holds it."

msgid "drawings.files.discipline_sheet_taken"
msgstr "{discipline} already has a sheet {sheet} from another file, so this file's Discipline was not changed. Open {sheet} in Step 1 to see which file it comes from, or tell Vextrus."

msgid "drawings.files.discipline_unknown"
msgstr "That Discipline is not one Vextrus offers here, so nothing was changed. Choose one of those shown."

msgid "drawings.files.discipline_unnumbered_decided"
msgstr "A sheet from this file is already confirmed or left out in Step 1, so the file's Discipline was not changed. To change it, undo that decision in Step 1 first."

msgid "drawings.files.failed"
msgstr "Could not be read after {tries, plural, one {# try} other {# tries}}. The file is kept."

msgid "drawings.files.finding_sheets"
msgstr "Finding the sheets"

msgid "drawings.files.finishing"
msgstr "Finishing"

msgid "drawings.files.held"
msgstr "Held: the two readers disagree, so it may be misread"

msgid "drawings.files.held_read_anyway"
msgstr "Held, read anyway: its sheets are marked"

msgid "drawings.files.marked_for_vextrus"
msgstr "{actor} marked a file for Vextrus to check"

msgid "drawings.files.matching_pages"
msgstr "Matching pages to sheets"

msgid "drawings.files.not_failed"
msgstr "This file was not marked for Vextrus: nothing in its reading needs Vextrus to look at it. Its row shows where it stands; if something in it looks wrong, tell Vextrus."

msgid "drawings.files.not_stopped"
msgstr "This file's reading has not stopped, so it was not started again. Its row shows where it is."

msgid "drawings.files.old_version"
msgstr "Saved by a version of AutoCAD that Vextrus cannot read yet. Save it from AutoCAD as a 2018 DWG and add it again."

msgid "drawings.files.opening_file"
msgstr "Opening the file"

msgid "drawings.files.opening_pdf"
msgstr "Opening the PDF"

msgid "drawings.files.plot_matched"
msgstr "Plot: {matched} of {pages, plural, one {# page} other {# pages}} matched"

msgid "drawings.files.plot_matched_lines"
msgstr "Plot: {matched} of {pages, plural, one {# page} other {# pages}} matched; lettering as lines"

msgid "drawings.files.plot_waiting"
msgstr "Plot: waiting for its DWG. Its pages are matched when the DWG is read."

msgid "drawings.files.read"
msgstr "Read. Two readers agree"

msgid "drawings.files.read_bangla"
msgstr "Read. Two readers agree. 1 flag: Bangla text"

msgid "drawings.files.read_cancelled"
msgstr "{actor} cancelled reading a file"

msgid "drawings.files.read_restarted"
msgstr "{actor} started reading a file again"

msgid "drawings.files.reading_drawing"
msgstr "Reading the drawing"

msgid "drawings.files.reading_page"
msgstr "Reading page {position} of {total}"

msgid "drawings.files.reading_page_left"
msgstr "Reading page {position} of {total}, about {minutes} min left"

msgid "drawings.files.reading_sheet"
msgstr "Reading sheet {position} of {total}"

msgid "drawings.files.reading_sheet_left"
msgstr "Reading sheet {position} of {total}, about {minutes} min left"

msgid "drawings.files.refused_scan"
msgstr "Refused: a scan, not a drawing"

msgid "drawings.files.retrying"
msgstr "Reading was interrupted. Trying again by itself (try {attempt} of {tries})."

msgid "drawings.files.second_reader"
msgstr "Checking it with a second reader"

msgid "drawings.files.sent_to_vextrus"
msgstr "Set aside: sent to Vextrus to check"

msgid "drawings.files.stopping"
msgstr "Stopping…"

msgid "drawings.files.summary"
msgstr "{files, plural, one {# file} other {# files}}: {sheets, plural, one {# sheet read} other {# sheets read}}{reading, plural, =0 {} one {, # file reading} other {, # files reading}}{failed, plural, =0 {} other {, # could not be read}}{held, plural, =0 {} other {, # held}}{refused, plural, =0 {} other {, # refused}}"

msgid "drawings.files.waiting"
msgstr "Waiting to be read ({ahead, plural, =0 {next} one {# file ahead} other {# files ahead}})"
