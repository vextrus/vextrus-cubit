#. vextrus/drawings/messages/reports.py (ticket 14): a file's report panel, in m0-screens 4.5's words.
msgid "drawings.reports.dwg_not_read"
msgstr "Its DWG is not read yet. Its pages are matched when the DWG is read."

msgid "drawings.reports.empty_layouts"
msgstr "{layouts, plural, one {# layout tab shows nothing, so it is not a sheet.} other {# layout tabs show nothing, so they are not sheets.}}"

msgid "drawings.reports.no_dwg_for_pages"
msgstr "No DWG has been added for these pages yet."

msgid "drawings.reports.no_plot"
msgstr "No PDF added for these sheets. Add the PDFs plotted from this file to compare them with what Vextrus read."

msgid "drawings.reports.no_sheets"
msgstr "Vextrus found no sheet borders or layout tabs in this file. If it has sheets, mark it for Vextrus."

msgid "drawings.reports.page_sheet_not_in_dwg"
msgstr "Page {page} shows sheet {sheet}, which is not in any DWG added so far."

msgid "drawings.reports.page_title_block_unread"
msgstr "Page {page}: its title block could not be read."

msgid "drawings.reports.pages_matched"
msgstr "{matched} of {pages, plural, one {# page} other {# pages}} matched to a sheet."

msgid "drawings.reports.pages_same_sheet"
msgstr "Pages {first_page} and {used_page} both show {sheet}; page {used_page} is used."

msgid "drawings.reports.plot_none_matched"
msgstr "{plot_file} was added, but none of its pages matched these sheets. Its report says why for each page."

msgid "drawings.reports.plot_of_dwg"
msgstr "Its Plot is {plot_file}: {with_page, plural, one {# of {sheets, plural, one {# sheet} other {# sheets}} has} other {# of {sheets, plural, one {# sheet} other {# sheets}} have}} a page."

msgid "drawings.reports.plot_part"
msgstr "{plot_file} has a page for {with_page} of {sheets, plural, one {# sheet} other {# sheets}}."

msgid "drawings.reports.plot_reading"
msgstr "{plot_file} is not read yet."

msgid "drawings.reports.plot_refused"
msgstr "{plot_file} was a scan, so it was refused. Ask the consultant for a PDF plotted from AutoCAD."

msgid "drawings.reports.plot_refused_unused"
msgstr "{plot_file} was a scan, so it was refused and is not used."

msgid "drawings.reports.plot_unread"
msgstr "{plot_file} was not read. Its row says why."

msgid "drawings.reports.readers_agree"
msgstr "✓ Read twice, by two independent readers, and they agree. Nothing in the file was skipped."

msgid "drawings.reports.sheet_revision_without_page"
msgstr "{sheet} (rev {revision}) has no page in this PDF."

msgid "drawings.reports.sheet_without_page"
msgstr "{sheet} has no page in this PDF."

msgid "drawings.reports.sheets_found"
msgstr "{sheets, plural, one {# sheet found} other {# sheets found}}: {drawn} laid out in the drawing, {layouts, plural, one {# on a layout tab} other {# on layout tabs}}."

msgid "drawings.reports.sheets_found_drawn"
msgstr "{sheets, plural, one {# sheet found, laid out in the drawing.} other {# sheets found, all laid out in the drawing.}}"

msgid "drawings.reports.sheets_found_layouts"
msgstr "{sheets, plural, one {# sheet found, on a layout tab.} other {# sheets found, all on layout tabs.}}"

msgid "drawings.reports.sheets_not_kept"
msgstr "{sheets, plural, one {# sheet is missing from the sheet list: a text on it is longer than Vextrus can keep.} other {# sheets are missing from the sheet list: a text on each is longer than Vextrus can keep.}} Mark the file for Vextrus."

msgid "drawings.reports.views_not_kept"
msgstr "{views, plural, one {# view is missing from its sheet: a text in it is longer than Vextrus can keep.} other {# views are missing from their sheets: a text in each is longer than Vextrus can keep.}} Mark the file for Vextrus."
