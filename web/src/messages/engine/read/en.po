#. engine/messages/read.py (ticket 04): the DWG reader's codes.
msgid "engine.read.aligned_text_from_start"
msgstr "{count, plural, one {# aligned text is drawn from its start point, as AutoCAD plots it} other {# aligned texts are drawn from their start points, as AutoCAD plots them}}"

msgid "engine.read.attrib_style_from_attdef"
msgstr "{count, plural, one {# attribute's own text style could not be read, so it is lettered in the style its block gives it} other {# attributes' own text styles could not be read, so they are lettered in the styles their blocks give them}}"

msgid "engine.read.dxf_recovered"
msgstr "The drawing's geometry was read in recovery mode ({errors, plural, one {# error} other {# errors}} repaired)"

msgid "engine.read.geometry_missing"
msgstr "{count, plural, one {# item was read without its geometry} other {# items were read without their geometry}}"

msgid "engine.read.layer_unresolved"
msgstr "{count, plural, one {# item names a layer the file does not hold} other {# items name a layer the file does not hold}}"

msgid "engine.read.limit_reached"
msgstr "{limit, select, cpu {The drawing could not be read in the time Vextrus gives one file. Try again; if it stops again, mark the file for Vextrus.} wall {The drawing could not be read in the time Vextrus gives one file. Try again; if it stops again, mark the file for Vextrus.} killed {The drawing could not be read: the machine reading it stopped it, most likely because it needed more memory than the machine could give. Mark the file for Vextrus.} other {The drawing could not be read: reading it reached a limit Vextrus sets on one file. Mark the file for Vextrus.}}"

msgid "engine.read.objects_missing"
msgstr "The drawing could not be read: {count, plural, one {# object it lists is} other {# objects it lists are}} missing, so the file may be damaged"

msgid "engine.read.output_unreadable"
msgstr "The drawing could not be read: what Vextrus read from it could not be understood. This is most likely a fault on Vextrus's side. Mark the file for Vextrus."

msgid "engine.read.reader_failed"
msgstr "The drawing could not be read: reading it stopped before the end. The file may be damaged, or the fault may be on Vextrus's side. Try again; if it stops again, mark the file for Vextrus."

msgid "engine.read.sandbox_refused"
msgstr "Vextrus stopped before reading this file because its usual safeguards were not in place. This is a fault on Vextrus's side, not in your file. Mark the file for Vextrus."

msgid "engine.read.sandbox_unavailable"
msgstr "Vextrus could not read this file: the safeguards it reads drawings under are not working. This is a fault on Vextrus's side, not in your file. Mark the file for Vextrus."

msgid "engine.read.unsupported_format"
msgstr "{format, select, pdf {This PDF is read as a Plot, not as a drawing} other {This file is not a DWG drawing}}"
