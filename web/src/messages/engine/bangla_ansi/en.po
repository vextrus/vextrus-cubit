#. engine/messages/bangla_ansi.py (ticket 11): the file report's Bangla text section (m0-screens 4.5).
msgid "engine.bangla_ansi.found"
msgstr "{texts, plural, one {# text} other {# texts}} {sheets, plural, =0 {outside the sheets} one {on # sheet} other {on # sheets}} {texts, plural, one {is} other {are}} Bangla typed in an old Bijoy-style font ({font}{other_fonts, plural, =0 {} one { and # other such font} other { and # other such fonts}}). Such fonts store Bangla as Latin letters, so {texts, plural, one {this text shows as it does in AutoCAD and Vextrus cannot read it} other {these texts show as they do in AutoCAD and Vextrus cannot read them}}. Nothing else {sheets, plural, =0 {} one {on that sheet } other {on those sheets }}is affected. If a room name or a note in Bangla matters, ask the consultant to set it in a Unicode Bangla font."

msgid "engine.bangla_ansi.found_by_pattern"
msgstr "{texts, plural, one {# text} other {# texts}} {sheets, plural, =0 {outside the sheets} one {on # sheet} other {on # sheets}} {texts, plural, one {looks} other {look}} like Bangla typed in an old font. Such fonts store Bangla as Latin letters, so {texts, plural, one {this text shows as it does in AutoCAD and Vextrus cannot read it} other {these texts show as they do in AutoCAD and Vextrus cannot read them}}. Nothing else {sheets, plural, =0 {} one {on that sheet } other {on those sheets }}is affected. If a room name or a note in Bangla matters, ask the consultant to set it in a Unicode Bangla font."

msgid "engine.bangla_ansi.sheet"
msgstr "{sheet}: {texts, plural, one {# text} other {# texts}}"
