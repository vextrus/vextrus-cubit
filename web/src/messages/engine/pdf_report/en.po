#. engine/messages/pdf_report.py (ticket 12): the PDF upload report, after m0-screens 4.5.
#. PDFSHX at 1 is from Autodesk's "PDFSHX System Variable" page, AutoCAD 2026 Help, read 28 Sep 2026 (engine/read/pdf cites it).
msgid "engine.pdf_report.fonts_drawn"
msgstr "{fonts, plural, one {Text in # font is drawn as shapes, not letters, so Vextrus may not read it. The Plot still looks right.} other {Text in # fonts is drawn as shapes, not letters, so Vextrus may not read it. The Plot still looks right.}}"

msgid "engine.pdf_report.fonts_not_embedded"
msgstr "{fonts, plural, one {# font is not included in the PDF. Its text still reads as text, but its letters may look slightly different in the Plot here than on the consultant's screen.} other {# fonts are not included in the PDF. Their text still reads as text, but their letters may look slightly different in the Plot here than on the consultant's screen.}}"

msgid "engine.pdf_report.fonts_unreadable"
msgstr "{fonts, plural, one {# font in the PDF is damaged, so its text cannot be read. The rest of the PDF is read. If that text matters, ask the consultant to plot the PDF again.} other {# fonts in the PDF are damaged, so their text cannot be read. The rest of the PDF is read. If that text matters, ask the consultant to plot the PDF again.}}"

msgid "engine.pdf_report.layers_flattened"
msgstr "The layers were flattened: everything is on one layer. The Plot is still fine to look at."

msgid "engine.pdf_report.layers_kept"
msgstr "The drawing's layers are kept in the PDF."

msgid "engine.pdf_report.lettering_kept"
msgstr "The AutoCAD lettering is kept as text on every page."

msgid "engine.pdf_report.lettering_lines"
msgstr "{pages, plural, one {On # page the lettering is drawn as lines, not text.} other {On # pages the lettering is drawn as lines, not text.}} The Plot still looks right, but a machine cannot read that text. If you ask the consultant for a new PDF, ask them to plot it with AutoCAD's DWG To PDF plotter, its PDFSHX setting at 1 and \"Convert all text to geometry\" off, so the lettering stays text."

msgid "engine.pdf_report.lettering_partly"
msgstr "The AutoCAD lettering is kept as text on {pages} of {drawn} drawn pages."

msgid "engine.pdf_report.lettering_unconfirmed"
msgstr "{pages, plural, one {# page has its text in ordinary fonts, and the PDF cannot show whether any AutoCAD lettering on it was kept.} other {# pages have their text in ordinary fonts, and the PDF cannot show whether any AutoCAD lettering on them was kept.}} If this file's DWG lists Romans or another AutoCAD lettering, that lettering is drawn as lines here: ask the consultant to plot with AutoCAD's DWG To PDF plotter and its PDFSHX setting at 1."

msgid "engine.pdf_report.limit_reached"
msgstr "{limit, select, memory {This PDF needs more memory than Vextrus gives one file, so it was not read.} killed {This PDF needs more memory than Vextrus gives one file, so it was not read.} output {This PDF holds more text than Vextrus reads from one file, so it was not read.} other {Vextrus could not finish reading this PDF in the time it gives one file, so it was not read.}} Ask the consultant for one PDF per DWG, or for the DWG files; if you need this one, mark it for Vextrus."

msgid "engine.pdf_report.locked"
msgstr "This PDF is locked with a password, so Vextrus cannot read it. Ask the consultant for a copy without a password, or for the DWG files."

msgid "engine.pdf_report.made_by_autocad"
msgstr "Made by AutoCAD's PDF plotter."

msgid "engine.pdf_report.made_by_other"
msgstr "Made by {producer}, not AutoCAD: it may have been merged or re-saved. Its lines are still the plot's, but a page may not line up exactly with its sheet."

msgid "engine.pdf_report.made_by_unknown"
msgstr "The PDF does not say what made it."

msgid "engine.pdf_report.mostly_picture"
msgstr "Page {page} is mostly a picture ({percent}%): it may be a scan."

msgid "engine.pdf_report.no_pictures"
msgstr "No pictures."

msgid "engine.pdf_report.page_unreadable"
msgstr "Page {page} is damaged, so only part of it was read. Ask the consultant to plot that sheet again."

msgid "engine.pdf_report.pages"
msgstr "{pages, plural, one {# page.} other {# pages.}}{turned, plural, =0 {} one { # is turned; Vextrus turns it to match its sheet.} other { # are turned; Vextrus turns them to match their sheets.}}"

msgid "engine.pdf_report.pictures"
msgstr "{pages, plural, one {Pictures on # page} other {Pictures on # pages}}, covering at most {percent}% of a page (logos, stamps or photos)."

msgid "engine.pdf_report.reader_failed"
msgstr "This PDF could not be read because of a fault in Vextrus, not in the file. Try again, or mark it for Vextrus."

msgid "engine.pdf_report.scan"
msgstr "This PDF is a scan: its pages are pictures, with no lines or text to read. Vextrus reads drawings, not scans. Ask the Developer or the consultant for the DWG files, or for a PDF plotted from AutoCAD."

msgid "engine.pdf_report.scan_page"
msgstr "Page {page} is a scan: a picture with no lines or text, so Vextrus cannot match it to a sheet. Ask the consultant for that sheet plotted from AutoCAD."

msgid "engine.pdf_report.too_many_pages"
msgstr "This PDF has more than {limit} pages, so Vextrus did not read it. Ask the consultant for one PDF per DWG, or for the DWG files."

msgid "engine.pdf_report.unmapped_text"
msgstr "{chars, plural, one {# letter cannot be read: its font does not say which letter or figure it is.} other {# letters cannot be read: their fonts do not say which letters or figures they are.}} The Plot still shows them, but Vextrus cannot use them to match pages to sheets. If a sheet's number or title is among them, ask the consultant to plot it again."

msgid "engine.pdf_report.unreadable"
msgstr "This PDF could not be read: it may be damaged. Ask the consultant for the PDF again, or for the DWG files."
