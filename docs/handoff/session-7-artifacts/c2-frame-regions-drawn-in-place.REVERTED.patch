+
+  test("the LANE standing twice and the first leaving: the second lane's row, with its surface's half, still stands (I-312)", () => {
+    // The row itself is drawn into the frame's track in place now, not handed over — so when the lane
+    // that drew it leaves, the lane still standing draws its own row, its host, and its surface's half.
+    function Lanes({ first, second }: { first: boolean; second: boolean }) {
+      return (
+        <ShellSlotsProvider>
+          <Toolbar />
+          {first ? (
+            <TakeoffTabs entries={[]}>
+              <Surface says="first lane says Measure" />
+            </TakeoffTabs>
+          ) : null}
+          {second ? (
+            <TakeoffTabs entries={[]}>
+              <Surface says="second lane says Measure" />
+            </TakeoffTabs>
+          ) : null}
+        </ShellSlotsProvider>
+      );
+    }
+    const view = render(<Lanes first={true} second={true} />);
+    expect(screen.getAllByTestId(TESTIDS.takeoff.nav), "one tabs row in the track while both lanes stand").toHaveLength(1);
+    view.rerender(<Lanes first={false} second={true} />);
+    expect(screen.getAllByTestId(TESTIDS.takeoff.nav), "the row still stands").toHaveLength(1);
+    expect(asideText(), "and the half the standing lane's surface draws is in it").toBe("second lane says Measure");
+  });
 });
