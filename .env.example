# VEXTRUS CUBIT — environment (src/core/env.ts is the zod-validated reader).
# Copy to .env and adjust. C-07: Postgres 16 native on 127.0.0.1:5544, no Docker in dev.

# --- the three database roles (SEAM-TENANT) -------------------------------
# migrate owns the schema, app carries tenant-scoped traffic, auth serves better-auth.
DATABASE_URL_MIGRATE=postgres://cubit_migrate:cubit_migrate@127.0.0.1:5544/cubit_dev
DATABASE_URL_APP=postgres://cubit_app:cubit_app@127.0.0.1:5544/cubit_dev
DATABASE_URL_AUTH=postgres://cubit_auth:cubit_auth@127.0.0.1:5544/cubit_dev

# --- auth (R-SPINE-001) ----------------------------------------------------
# No value here on purpose: a committed secret that stands in for an unset one
# is a deployment signing its session cookies with a value anyone can read in
# this file. Left unset, the toolchain mints 32 random bytes into the gitignored
# .env.local (scripts/lib/run.mjs) and `pnpm checkup` reports it as MINTED, not
# OK. A deployment sets its own:  openssl rand -hex 32
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3210

# --- outbound mail (AC-11) -------------------------------------------------
# file: one JSON {to, subject, kind, url} per message into MAIL_OUTBOX_DIR
# none: messages are dropped
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=.mail-outbox/

# --- web (C-07: dev 3210, e2e 3211) ---------------------------------------
PORT=3210
