# Vextrus Cubit — local development environment template (ARCH-02, AM-19)
# Copy to .env for custom overrides. .env is gitignored and never committed.
# The development lane (pnpm dev) automatically supplies defaults for these values.

# 1. Isolated development database connection (Postgres)
DATABASE_URL=postgres://cubit_app:cubit_app@127.0.0.1:5544/cubit_dev

# 2. Local storage root for uploads and job payloads
STORAGE_ROOT=storage/dev

# 3. Public base URL for mailed links and client redirects
CUBIT_PUBLIC_ORIGIN=http://127.0.0.1:3210

# 4. Port for worker process health endpoint
WORKER_HEALTH_PORT=3212

# 5. Root directory containing model fixture assets
CUBIT_MODEL_FIXTURE_ROOT=fixtures/rcc6

# 6. HMAC signing secret for signed object storage URLs
CUBIT_STORAGE_SIGNING_SECRET=dev-insecure-storage-signing-secret

# 7. Command for CAD extraction engine invocation (optional in core dev)
CUBIT_CAD_COMMAND=uv run --project cad python cad/main.py

# 8. TypeSafe API key for Jev System One model evaluations (optional; no default — without it the
#    dev lane replays model answers from the fixture root and makes no live model call)
TYPESAFE_API_KEY=
