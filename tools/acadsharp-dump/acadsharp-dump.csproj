<!--
  The ACadSharp dumper (ticket 10; ADR 0029): Program.cs says what it writes.

  Published as one self-contained file for linux-x64: the .NET runtime is inside it, so the machine
  that runs it needs no .NET, and nothing is restored or built where it runs (the runtime still JIT-
  compiles the code as it runs, as .NET does). The build is reproducible: the same source, SDK
  (global.json, which never rolls forward, and toolchain/dotnet.version, a test holding the two
  equal) and packages give the same bytes, whose sha256 is pinned in toolchain/acadsharp-dump.sha256,
  wherever it is built, a git work tree included, since EnableSourceControlManagerQueries is off
  (with it on, the SDK stamps the enclosing repository's HEAD into the version: measured, another
  hash) and PathMap maps the build folder to /_/ (a source generator's file-local types are named
  after a hash of the source's path: measured, two folders gave two hashes; Program.cs uses no
  generator, and PathMap keeps any path out). The packages: ACadSharp and the build's ILLink task are pinned by hash in packages.lock.json
  (restored in locked mode); the .NET runtime pack is not in the lock (NuGet's lock lists no runtime
  pack; the SDK chooses 10.0.12, the version it bundles), so its .nupkg is pinned by its sha512 in
  toolchain/acadsharp-dump.runtime.sha512, checked after the restore and before the build. The
  ASP.NET pack is not fetched (DisableTransitiveFrameworkReferenceDownloads). scripts/owner/toolchain.sh
  builds it and installs it only when its hash is the pin; the reader (engine/read/acadsharp/) runs
  it only when its hash is the pin.

  What is inside it, and the licences (checked 28 Sep 2026): ACadSharp 3.8.0, MIT (its NuGet
  package's `<license type="expression">MIT</license>`, "Copyright (c) 2026 Albert Domenech"; its
  net10.0 build depends on no other package; ACADSHARP-LICENSE.txt); and the .NET 10 runtime
  (Microsoft.NETCore.App.Runtime.linux-x64 10.0.12 and its single-file host), MIT, which itself
  carries third-party code under MIT, BSD, zlib (zlib-ng), Apache-2.0 and the Unicode licence, listed
  in its THIRD-PARTY-NOTICES.TXT: permissive, none copyleft. Each asks that its notice go with every
  copy, so toolchain.sh installs ACADSHARP-LICENSE.txt and the runtime's LICENSE.TXT and
  THIRD-PARTY-NOTICES.TXT beside the program. ICU is not inside it (invariant globalization). The
  build-only package Microsoft.NET.ILLink.Tasks (MIT) ships nothing.

  It runs in the reader's sandbox, which passes it no environment, so what it needs is fixed here:
  invariant globalization (no ICU) and workstation GC with no background thread. Measured on 28 Sep
  2026 (the entity_kinds fixture): it starts under an address-space limit of 1 GiB and is killed under
  512 MiB (the runtime's own reservations), so the sandbox's 3 GiB default leaves room. The runtime
  makes its diagnostics socket and debugger pipes in TMPDIR, which the sandbox points at the output
  folder; no runtimeconfig setting turns them off (only DOTNET_EnableDiagnostics, an environment
  variable the sandbox does not pass), they vanish when it exits, and the reader opens only the file
  it named, never following a link.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <AssemblyName>acadsharp-dump</AssemblyName>
    <RootNamespace>AcadSharpDump</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No git: inside a work tree the SDK's Source Link would stamp its HEAD into the version. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- No build path: whatever folder it is built in, the compiler sees it as /_/. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <!-- No compiler server left running after the build (it runs as root in toolchain.sh). -->
    <UseSharedCompilation>false</UseSharedCompilation>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <!-- Only the runtime pack this program ships is fetched, not ASP.NET's. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>

    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="[3.8.0]" />
  </ItemGroup>
</Project>
