# Founder seed — inc-000 Foundation owns and extends this (C-06).
node_modules/
.next*/
dist/
coverage/
*.log
.env*
!.env.example

# Toolchain outputs (C-06)
# next-env.d.ts is Next's own generated shim ("This file should not be edited"): `next typegen` and
# `next build` write it, and it points at whichever gitignored dist dir the last build used. It is
# build output, as create-next-app's scaffold treats it — inc-000-foundation ignored it; the fourth
# founding's reset dropped the line and inc-002 committed the file, and the engine grew six
# mechanisms to keep a tracked copy of a generated file from drifting (Vextrus Builder v21 L7).
next-env.d.ts
*.tsbuildinfo
.eslintcache
test-results/
playwright-report/
blob-report/
.vitest-reports/
.scratch/

# The storage root V-CHECKUP probes once src/app exists. The directory is committed empty; what
# the product ever writes into it is runtime data and never source.
storage/*
!storage/.gitkeep

# The cad extraction seam is uv-managed: its virtual environment and caches are build output
# (L-CAD-04 — stateless, temp per invocation), never source.
cad/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# The engine's held-out acceptance (the Verifier's answers, mounted only at gate time — Vextrus
# Builder v21 fault 266). It is never part of the tree: not by `git add -A`, not by a crash
# quarantine, not by any session. The engine excludes it by pathspec as well; this line is the
# product's own copy of the same law.
.builder-heldout/
