# Founder seed — inc-000 Foundation owns and extends this (C-06).
node_modules/
.next*/
dist/
coverage/
# The rule above is unanchored, so it swallows every source directory named `coverage` too —
# S-Coverage's module, its route and its suite among them. They are re-included by name: a
# directory has to be un-excluded before git will descend into it (inc-216).
!src/modules/takeoff/coverage/
!src/app/**/takeoff/coverage/
!tests/takeoff/coverage/
*.log
.env*
!.env.example

# Toolchain outputs (C-06)
*.tsbuildinfo
.eslintcache
test-results/
playwright-report/
blob-report/
.vitest-reports/
.scratch/

# The storage root V-CHECKUP probes once src/app exists. The directory is committed empty; what
# the product ever writes into it is runtime data and never source.
storage/*
!storage/.gitkeep

# The cad extraction seam is uv-managed: its virtual environment and caches are build output
# (L-CAD-04 — stateless, temp per invocation), never source.
cad/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
