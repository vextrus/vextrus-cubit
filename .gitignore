node_modules/
.pnpm-store/

# next — `.next` and every distDir a stage cuts for itself (NEXT_DIST_DIR)
.next/
.next-*/
out/
# generated by `next typegen`, and it names whichever distDir last ran —
# committing it would leave the tree dirty after every gate run
next-env.d.ts
build/
dist/
*.tsbuildinfo

# env — never committed; .env.example is the contract
.env
.env.local
.env.*.local

# the file mail transport's outbox (AC-11)
.mail-outbox/

# scratch: drift generation, scratch databases, throwaway probes
.scratch/
.drizzle-scratch/

# playwright
test-results/
playwright-report/
blob-report/
tests/e2e/.artifacts/
.storage/
