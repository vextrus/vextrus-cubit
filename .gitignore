# The owner's private material: real drawings (the Edison set, the Sample Project, client sets),
# everything derived from them, and working notes. Never enters git (the guard refuses it too).
/.private/

# Secrets and local settings
.env
.env.*
!.env.example
.claude/settings.local.json

# Worktrees made by sessions and workflows
/.claude/worktrees/

# Agents' own memory (spec 3.3): never committed; the guard refuses staging it too
.claude/agent-memory*/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
# ...but not the words of the Coverage Check (engine/messages/coverage.py's catalogue; 19b)
!/web/src/messages/engine/coverage/

# Generated API contract (regenerated by the dev and CI commands; never committed: ADR 0022)
openapi.json
**/api/schema.d.ts

# Runtime data
/storage/
*.log
# Every failed or errored test's id, kept by vextrus/testing/failures.py
/.pytest-failures.log

# Editors and OS
/.idea/
/.vscode/
.DS_Store
