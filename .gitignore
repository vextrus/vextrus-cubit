# The owner's private material: real drawings (the Edison set, the Sample Project, client sets),
# everything derived from them, and working notes. Never enters git (the guard refuses it too).
/.private/

# Secrets and local settings
.env
.env.*
!.env.example
.claude/settings.local.json

# Worktrees made by sessions and workflows
/.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/

# Generated API contract (regenerated by the dev and CI commands; never committed: ADR 0022)
openapi.json
**/api/schema.d.ts

# Runtime data
/storage/
*.log

# Editors and OS
/.idea/
/.vscode/
.DS_Store
