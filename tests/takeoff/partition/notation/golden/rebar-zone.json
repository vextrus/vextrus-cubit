  "cases": [
    { "input": "MAIN BAR", "expect": "main" },
    { "input": "MAIN REINF.", "expect": "main" },
    { "input": "LONGITUDINAL BAR", "expect": "main" },
    { "input": "VERTICAL BAR", "expect": "main" },
    { "input": "TIES", "expect": "ties" },
    { "input": "STIRRUPS", "expect": "ties" },
    { "input": "LINKS", "expect": "ties" },
    { "input": "LATERAL TIES", "expect": "ties" },
    { "input": "TIES END ZONE", "expect": "ties-end" },
    { "input": "TIES (END ZONE)", "expect": "ties-end" },
    { "input": "TIES MID ZONE", "expect": "ties-mid" },
    { "input": "TIES (MID ZONE)", "expect": "ties-mid" },
    { "input": "MARK", "expect": null },
    { "input": "GF TO 3RD", "expect": null }
  ]
}
