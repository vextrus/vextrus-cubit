# pnpm runs every script through its own shell emulator rather than the machine's /bin/sh.
# A script is then the same command on every machine, and running one does not depend on
# what the ambient PATH happens to contain — which is exactly what `pnpm checkup` has to be
# able to vary in order to report on the machine at all (V-CHECKUP).
shell-emulator=true

# save-exact: the stack is pinned exact here once (C-06, AC-5), and a caret added by a
# later `pnpm add` would unpin it silently.
save-exact=true
