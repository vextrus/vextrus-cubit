{
  // C-06: TypeScript strict, noUncheckedIndexedAccess, exactOptionalPropertyTypes.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // Next 16 requires the React automatic runtime and rewrites this key if it finds
    // anything else, so it is written here rather than left for a build to change.
    "jsx": "react-jsx",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "noEmit": true,
    "allowJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": false,

    // The editor plugin. Next adds it on the first build that does not find it, and a
    // build that rewrites the tree fails CI's "the tree is untouched" step.
    "plugins": [{ "name": "next" }]
  },
  // Risk note 3: tsc with an empty include errors "no inputs" before src/ exists, so the
  // toolchain's own TypeScript — configs, the plugin's types, the fixture suites — is the
  // input set until the product tree lands. The product globs are pre-wired and match
  // nothing yet.
  //
  // The three `.next*` entries are Next's own suggestion, and it makes it against whatever
  // distDir the build ran with: `pnpm verify` builds into .next-verify, `pnpm e2e` into
  // .next-e2e and `next dev` into .next (next.config.ts). All three are listed so that no
  // build has anything to add. They are excluded below and so match nothing — generated
  // route types are a build's output, and tsc runs before any build in the roster.
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "next.config.ts",
    "eslint-rules/cubit.d.ts",
    "tests/lint-fixtures/*.test.ts",
    "tests/toolchain/**/*.ts",
    "tests/e2e/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "db/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  // The bad fixtures are lint inputs, not compiler inputs: they are broken on purpose.
  "exclude": [
    "node_modules",
    ".next",
    ".next-verify",
    ".next-e2e",
    ".scratch",
    "dist",
    "tests/lint-fixtures/*/*"
  ]
}
