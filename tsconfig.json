{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "db/**/*.ts",
    "eslint-rules/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/toolchain/**/*.ts",
    "tests/lint-fixtures/**/*.test.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-verify",
    ".cubit-scratch",
    "cad",
    "tests/lint-fixtures/**/bad.ts",
    "tests/lint-fixtures/**/bad.tsx",
    "tests/lint-fixtures/**/good.ts",
    "tests/lint-fixtures/**/good.tsx"
  ]
}
