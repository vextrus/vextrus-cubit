{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "db/**/*.ts",
    "*.config.ts",
    ".next-cubit/types/**/*.ts",
    ".next-cubit/dev/types/**/*.ts",
    ".next-invitations/types/**/*.ts",
    ".next-invitations/dev/types/**/*.ts",
    ".next-members/types/**/*.ts",
    ".next-members/dev/types/**/*.ts",
    ".next-burst/types/**/*.ts",
    ".next-burst/dev/types/**/*.ts",
    ".next-probe/types/**/*.ts",
    ".next-probe/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/lint-fixtures",
    "tests/e2e"
  ]
}
