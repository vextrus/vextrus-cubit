#!/bin/sh
# The leak scan for every push (docs/specs/factory.md 5 item 4; leakscan-cli.md 6): for each ref git is
# about to push, `python -m tools.leakscan range <base>..<local sha> --ref <ref> --no-stamp`, where <base> is
# the remote's old sha, or for a new branch the merge-base with origin/main. A hit, a missing corpus or any
# failure refuses the push (fails closed). It prints locations and counts only. It runs once the
# orchestrator sets `git config core.hooksPath scripts/git-hooks` in the main checkout. A cloud session has no
# corpus and skips, saying so.
# The scanner is found from this file's own place, not the pushing repository.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
checkout=$(CDPATH= cd -- "$here/../.." && pwd -P) || exit 1
if [ -x "$checkout/.venv/bin/python" ]; then python=$checkout/.venv/bin/python; else python=python3; fi
zero=0000000000000000000000000000000000000000

if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ] && [ -z "${VEXTRUS_LEAKSCAN_HOME:-}" ] && [ ! -e "$checkout/.private" ]; then
  echo "pre-push: leak scan skipped (cloud session: no corpus)" >&2
  exit 0
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case $local_sha in "$zero") continue ;; esac   # a delete sends no content
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) || base=
    if [ -z "$base" ]; then
      echo "pre-push: a pushed ref has no merge-base with origin/main; refusing (fetch origin first)" >&2
      status=1
      continue
    fi
  else
    base=$remote_sha
  fi
  PYTHONPATH="$checkout${PYTHONPATH:+:$PYTHONPATH}" "$python" -m tools.leakscan range "$base..$local_sha" --ref "$remote_ref" --no-stamp >&2
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "pre-push: the leak scan refused a pushed ref (exit $code); remove the text, or allowlist a generic line with \`python -m tools.leakscan allow <file>:<line>\`" >&2
    status=1
  fi
done
exit $status
