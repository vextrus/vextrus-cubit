{
  "name": "cubit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "cubit": {
    "comment": "C-06 pins Node, pnpm, uv and typst. Node is pinned by .nvmrc and pnpm by packageManager; uv and typst are system tools, so their pins live here and `pnpm checkup` refuses a machine whose version differs. The Bible pins typst by version AND sha256 (AM-08), so BOTH halves live here and `pnpm checkup` refuses drift in either: it compares the version the binary reports and the sha256 of the bytes `which typst` resolves to. The release asset the binary came from, and the recipe that installs it, are recorded beside this digest in docs/toolchain/typst.md. The CI workflow installs the pinned uv version and nothing else.",
    "tools": {
      "uv": "0.12.5",
      "typst": {
        "version": "0.15.1",
        "sha256": "29273eaa04f6d00edd0c2bec578f565fc9c65be856bfbffc894567c68ed0b237"
      }
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test:golden": "node node_modules/vitest/vitest.mjs run --config tests/golden/vitest.config.ts && uv run --project cad pytest -q cad/tests/sanity/test_rcc6_golden.py cad/tests/sanity/test_golden_corpora.py cad/tests/rcc6_bnbc cad/tests/arch cad/tests/dwg/test_dwg_reference.py",
    "checkup": "node scripts/checkup.mjs",
    "test:db": "sh -c 'case \" $* \" in *--config*|*\" -c \"*) exec node scripts/db-test.mjs \"$@\";; *) exec node scripts/db-test.mjs --config db/__tests__/vitest.config.ts \"$@\";; esac' sh",
    "test:docs": "node scripts/docs-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:clean": "node scripts/e2e-clean.mjs",
    "e2e:retake": "node scripts/e2e-retake.mjs",
    "gate": "node scripts/gate.mjs",
    "probe": "node scripts/probe/probe.mjs",
    "probe:server": "node scripts/probe/server.mjs",
    "demo": "node --import tsx scripts/demo.mjs",
    "test:perf": "node scripts/e2e.mjs --journey PERF-",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:drift": "node scripts/db-drift.mjs",
    "db:migrate:dev": "node scripts/db-migrate-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "seed": "node scripts/seed.mjs",
    "method-hashes": "node scripts/method-hashes.mjs",
    "lint": "eslint . && eslint src/ui --max-warnings 0 --ignore-pattern 'src/ui/patterns/**' --ignore-pattern 'src/ui/primitives/core/**' --ignore-pattern 'src/ui/primitives/data/**' --ignore-pattern 'src/ui/shell/**'",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@trpc/server": "11.19.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "next": "16.3.6",
    "pg-boss": "10.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.13.2",
    "sonner": "2.0.8",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  }
}
