{
  "name": "cubit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.19.0"
  },
  "cubit": {
    "comment": "C-06 pins Node, pnpm, uv and typst. Node is pinned by .nvmrc and pnpm by packageManager; uv and typst are system tools, so their pins live here and `pnpm checkup` refuses a machine whose version differs. The CI workflow installs the pinned uv version and nothing else.",
    "tools": {
      "uv": "0.12.5",
      "typst": "0.13.1"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "checkup": "node scripts/checkup.mjs",
    "test:db": "sh -c 'case \" $* \" in *--config*|*\" -c \"*) exec node scripts/db-test.mjs \"$@\";; *) exec node scripts/db-test.mjs --config db/__tests__/vitest.config.ts \"$@\";; esac' sh",
    "e2e": "node scripts/e2e.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:drift": "node scripts/db-drift.mjs",
    "seed": "node scripts/seed.mjs",
    "method-hashes": "node scripts/method-hashes.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^2.0.8"
  }
}
